# Copy to .env.local for local dev, and set the same in Vercel for production.

# Production URL (no trailing slash). Used for canonical/OG/sitemap.
NEXT_PUBLIC_SITE_URL="https://eventproseating.com"

# Optional: quote form email delivery via Resend (https://resend.com).
# Without these the form still works and logs the request to the server console.
# RESEND_API_KEY=""
# QUOTE_TO_EMAIL="info@eventproseating.com"
# QUOTE_FROM_EMAIL="EventPro Website <quotes@eventproseating.com>"
